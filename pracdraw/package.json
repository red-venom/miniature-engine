{
  "name": "pracdraw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "sheet": "tsx scripts/sheet.ts",
    "render": "tsx scripts/render.ts",
    "gen:skill": "tsx scripts/gen-skill.ts",
    "gen:inventory": "tsx scripts/gen-inventory.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run e2e",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "progress": "tsx scripts/progress.ts",
    "release:a": "RELEASE=A vitest run src/spec.test.ts",
    "release:a:symbols": "RELEASE=A vitest run src/spec.test.ts -t \"symbols match the catalogue\"",
    "release:b": "RELEASE=B vitest run src/spec.test.ts",
    "release:c": "RELEASE=C vitest run src/spec.test.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
